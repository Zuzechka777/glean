# --- обязательное ---
# Ключ Google AI Studio: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- опциональное ---
# Groq (точный русский ASR, стратегия whisper+gemini): https://console.groq.com/keys
GROQ_API_KEY=
# Apify (фолбэк-скачивание без cookies): https://console.apify.com/account/integrations
APIFY_TOKEN=

# Fallback Telegram-бот (reels-inbox bot): токен у @BotFather, свой numeric id у @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_USER_ID=

# Прокси для Instagram и Google API, если VPN не включён постоянно.
# Поддерживаются http:// и socks5://, например socks5://127.0.0.1:1080
REELS_PROXY=
